<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <directoryBrowse enabled="true" />
        <rewrite>
            <rules>
                <rule name="PosRoute">
                    <match url=".*" />
                    <action type="Rewrite" url="src/server.js" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
     <appSettings>
        <add key="PORT" value="5001" />
        </appSettings>
</configuration>
